{
  "assumption_catalog": {
    "bounded_cylinder_multiplicity": {
      "allowed_values": [
        "yes",
        "no",
        "unknown"
      ],
      "description": "Depth-n cylinder family has a uniform pointwise overlap bound independent of depth on the target subclass.",
      "label": "bounded cylinder multiplicity"
    },
    "bounded_distortion": {
      "allowed_values": [
        "yes",
        "no",
        "unknown"
      ],
      "description": "Cylinder diameters are uniformly comparable to nominal contraction products.",
      "label": "Bounded distortion"
    },
    "disjoint_cylinder_geometry": {
      "allowed_values": [
        "yes",
        "no",
        "unknown"
      ],
      "description": "Depth-n cylinder images are pairwise disjoint or uniformly separated so upper and lower geometric sums coincide at cylinder scale.",
      "label": "Disjoint cylinder geometry"
    },
    "equal_scale_cylinders": {
      "allowed_values": [
        "yes",
        "no",
        "unknown"
      ],
      "description": "Depth-n cylinder images in the target subclass have a common contraction scale at each fixed depth.",
      "label": "equal-scale cylinders"
    },
    "exact_cylinder_packaging": {
      "allowed_values": [
        "yes",
        "no",
        "unknown"
      ],
      "description": "The lower-pressure packaging at depth n is exactly the family of depth-n cylinder images, not a coarser or adaptive grouping.",
      "label": "Exact cylinder packaging"
    },
    "feedback_free_admissibility": {
      "allowed_values": [
        "yes",
        "no",
        "unknown"
      ],
      "description": "Admissibility does not change through runtime feedback states.",
      "label": "Feedback-free admissibility"
    },
    "finite_memory_bound": {
      "allowed_values": [
        "yes",
        "no",
        "unknown"
      ],
      "description": "Admissibility depends on bounded memory or explicit finite control state.",
      "label": "Finite memory bound"
    },
    "fixed_lens": {
      "allowed_values": [
        "yes",
        "no",
        "unknown"
      ],
      "description": "Lens/representation choice is fixed and not updated during the run.",
      "label": "Fixed lens"
    },
    "fixed_packaging": {
      "allowed_values": [
        "yes",
        "no",
        "unknown"
      ],
      "description": "Packaging/coalescing rule is fixed and not updated during the run.",
      "label": "Fixed packaging"
    },
    "lens_affects_admissibility": {
      "allowed_values": [
        "yes",
        "no",
        "unknown"
      ],
      "description": "Lens choice changes which branches are admissible.",
      "label": "Lens affects admissibility"
    },
    "lower_pressure_packaging_admissible": {
      "allowed_values": [
        "yes",
        "no",
        "unknown"
      ],
      "description": "The packaging rule is legitimate for lower-pressure geometric sums, not just bookkeeping.",
      "label": "Lower-pressure packaging admissible"
    },
    "packaging_affects_admissibility": {
      "allowed_values": [
        "yes",
        "no",
        "unknown"
      ],
      "description": "Packaging choice changes which branches are admissible.",
      "label": "Packaging affects admissibility"
    },
    "quasi_multiplicativity": {
      "allowed_values": [
        "yes",
        "no",
        "unknown"
      ],
      "description": "Branch weights satisfy a uniform multiplicative comparison under concatenation.",
      "label": "Quasi-multiplicativity"
    },
    "stationary_admissibility_rule": {
      "allowed_values": [
        "yes",
        "no",
        "unknown"
      ],
      "description": "Admissibility law does not change with stage.",
      "label": "Fixed/stationary admissibility rule"
    },
    "tempered_memory": {
      "allowed_values": [
        "yes",
        "no",
        "unknown"
      ],
      "description": "Memory/protocol complexity grows slowly enough for asymptotic pressure control.",
      "label": "Tempered memory"
    },
    "uniform_contraction": {
      "allowed_values": [
        "yes",
        "no",
        "unknown"
      ],
      "description": "All branch maps contract uniformly below 1.",
      "label": "Uniform contraction"
    },
    "usable_separation": {
      "allowed_values": [
        "yes",
        "no",
        "unknown"
      ],
      "description": "Overlap is controlled enough for covering and lower-pressure arguments.",
      "label": "Usable separation"
    }
  },
