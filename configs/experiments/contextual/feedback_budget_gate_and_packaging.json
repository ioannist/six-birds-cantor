{
  "schema_version": "1.0",
  "experiment_id": "feedback-budget-gate-and-packaging",
  "family_id": "contextual_local.feedback_budget_gate_and_packaging",
  "engine": "contextual_feedback",
  "description": "Budget metric drives gating strictness and packaging mode updates.",
  "lens_mode": "raw_cylinders",
  "packaging_mode": "merge_touching",
  "parameters": {
    "family_kind": "budget_gate_and_packaging",
    "base": 3,
    "steps": 8,
    "initial_protocol_state": "fixed",
    "initial_gating_state": "permissive",
    "protocol_digits": {
      "fixed": [0, 1, 2]
    },
    "gating_digits_by_state": {
      "permissive": [0, 1, 2],
      "strict": [0, 2]
    },
    "budget_cap_metric": 2.0,
    "budget_interval_cap": 2,
    "packaging_by_gating_state": {
      "permissive": "merge_touching",
      "strict": "budget_capped_merge"
    }
  },
  "run_controls": {
    "seed": 0,
    "save_outputs": true
  },
  "output_root": "results/feedback_contextual/feedback-budget-gate-and-packaging"
}
